<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <BaseOutputPath>.\bin</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Siemens.Collaboration.Net.OperatingSystem.Windows" Version="3.0.1725521661" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Openness.Resolver" Version="2.0.1765367256" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Packages.Openness" Version="20.0.1744190253" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Management">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\System.Management.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Direct PLC (S7CommPlus) diagnostics - bypasses Openness entirely, see THIRD_PARTY_LICENSES.md.
         Referenced as prebuilt DLLs rather than ProjectReference: the submodule's legacy-format
         csproj only defines Debug/Release x64|x86 configs (no AnyCPU) and targets net4.7.2 (no
         targeting pack installed here, only net48) - a ProjectReference forces Platform=x64 onto
         this whole project's own build, which changes its output path. Rebuild the DLLs after
         updating the submodule with:
           dotnet build third_party\S7CommPlusDriver\src\S7CommPlusDriver\S7CommPlusDriver.csproj -c Debug -p:Platform=x64 -p:TargetFrameworkVersion=v4.8 -->
    <Reference Include="S7CommPlusDriver">
      <HintPath>..\..\third_party\S7CommPlusDriver\src\S7CommPlusDriver\bin\x64\Debug\S7CommPlusDriver.dll</HintPath>
    </Reference>
    <Reference Include="zlib.net">
      <HintPath>..\..\third_party\S7CommPlusDriver\src\Zlib.net\bin\x64\Debug\zlib.net.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- S7CommPlusDriver P/Invokes OpenSSL directly (libssl/libcrypto), loaded from the running
         exe's own directory - must be copied here explicitly, a managed DLL reference alone does
         not bring along a dependency's native siblings. -->
    <None Include="..\..\third_party\S7CommPlusDriver\src\S7CommPlusDriver\OpenSSL-dll-x64\libssl-3-x64.dll" Link="libssl-3-x64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\S7CommPlusDriver\src\S7CommPlusDriver\OpenSSL-dll-x64\libcrypto-3-x64.dll" Link="libcrypto-3-x64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Include="tests\**" />
  </ItemGroup>
</Project>